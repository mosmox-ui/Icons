{
  "name": "@mosmox-ui/icons",
  "version": "1.0.1",
  "description": "Customizable React SVG icons for Mosmox UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["src", "assets", "dist", "LICENSE", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/index.js",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit false --outDir dist --declaration"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
